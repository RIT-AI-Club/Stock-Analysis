# Copy to .env and fill in. Never commit .env.

# Required. OpenAI API key used by the format_report tool.
OPENAI_API_KEY=

# Optional. Model for completions (default: gpt-5-mini).
OPENAI_MODEL=gpt-5-mini

# Optional. Where format_report saves generated files (default: output/html, output/pdf).
HTML_OUTPUT_DIR=output/html
PDF_OUTPUT_DIR=output/pdf
