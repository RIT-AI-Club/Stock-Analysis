# Normalize line endings: LF in the repo, regardless of contributor OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.parquet binary
*.pkl binary

# Generated - collapse in GitHub diffs.
uv.lock linguist-generated=true
package-lock.json linguist-generated=true
